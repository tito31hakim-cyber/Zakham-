# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing credentials — never commit the release keystore config.
/android/key.properties

# Firebase client config — the files carry the project API key. The key
# ships inside every APK anyway, but these files belong in Codemagic
# secrets, not in Git. (They were committed in 7aff55d before this rule;
# removing them from tracking needs the Codemagic secret in place first
# — see the plan execution log, P7 — or the next build breaks.)
google-services.json
GoogleService-Info.plist

# Local env / service-account credentials — never commit.
.env
.env.*
*-service-account*.json
service-account*.json

# Widget Preview related
.widget_preview/
